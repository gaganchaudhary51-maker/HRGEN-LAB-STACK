LAB_NAME=Your Laboratory Name
LAB_NABL_NO=
LAB_PHONE=
LAB_EMAIL=
LAB_ADDRESS=
PATHOLOGIST_NAME=
PATHOLOGIST_MCI=
BIOCHEMIST_NAME=

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root { font-family:'DM Sans',sans-serif; color:#f1f3f2; background:#050606; font-synthesis:none; text-rendering:optimizeLegibility; --green:#48ed86; --lime:#b7ff67; --muted:#9ca5a0; --panel:#101211; --line:rgba(180,195,184,.16); }
* {
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
}
body { margin:0; background:#000; }
button,
input,
textarea,
select {
  font: inherit;
}
button,
a {
  -webkit-tap-highlight-color: transparent;
}
button {
  cursor: pointer;
}
a {
  color: inherit;
  text-decoration: none;
}
.app {
  min-height: 100vh;
  overflow: hidden;
}
.topline {
  height: 32px;
  padding: 0 5.5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #0c1b10;
  color: #a7bbaa;
  font-size: 11px;
  letter-spacing: 0.02em;
}
.topline span {
  display: flex;
  align-items: center;
  gap: 7px;
}
.topline svg {
  color: var(--green);
}
.header {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 5.5%;
  border-bottom: 1px solid var(--line);
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(0, 0, 0, 0.94);
  backdrop-filter: blur(18px);
}
.brand {
  display: flex;
  gap: 11px;
  align-items: center;
}
.logo {
  width: 43px;
  height: 43px;
  border: 1px solid #47d977;
  border-radius: 14px;
  display: grid;
  place-items: center;
  color: #effff2;
  font-family: Manrope, sans-serif;
  font-weight: 800;
  font-size: 17px;
  letter-spacing: -1.5px;
  background: linear-gradient(145deg, #193d24, #0b1710);
  box-shadow: 0 0 25px #36d86a15;
}
.logo span {
  color: var(--green);
}
.brand b {
  display: block;
  font:
    800 15px Manrope,
    sans-serif;
  letter-spacing: -0.4px;
}
.brand small {
  display: block;
  font-size: 8px;
  color: #83b891;
  letter-spacing: 1.45px;
  margin-top: 4px;
}
.header nav {
  display: flex;
  align-items: center;
  gap: 28px;
  font-size: 12px;
  color: #c0cec3;
}
.header nav a:hover,
.navlink:hover {
  color: var(--green);
}
.navlink {
  border: 0;
  background: none;
  color: inherit;
  padding: 0;
}
.headActions {
  display: flex;
  gap: 10px;
  align-items: center;
}
.iconBtn {
  width: 40px;
  height: 40px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #101b13;
  color: #d8e9dc;
  display: grid;
  place-items: center;
}
.cartBtn {
  display: flex;
  align-items: center;
  gap: 9px;
  background: var(--green);
  color: #06100a;
  border: 0;
  border-radius: 12px;
  padding: 12px 15px;
  font-size: 12px;
  font-weight: 800;
}
.cartBtn b {
  background: #092311;
  color: #b8ffc9;
  padding: 3px 7px;
  border-radius: 20px;
}
.hero {
  margin: 28px 5.5% 0;
  min-height: 460px;
  position: relative;
  border: 1px solid rgba(72, 237, 134, 0.25);
  border-radius: 26px;
  background: linear-gradient(115deg, #080a09 0%, #101311 48%, #080b09 100%);
  display: grid;
  grid-template-columns: 1.03fr 0.97fr;
  overflow: hidden;
  box-shadow: 0 24px 80px #0003;
}
.hero:before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 70% 40%, #3bf17c17, transparent 40%); pointer-events: none; z-index: 1; }
.dnaBackdrop { position:absolute; z-index:1; right:2%; top:-8%; width:43%; height:115%; overflow:hidden; opacity:.46; pointer-events:none; mask-image:linear-gradient(90deg,transparent,#000 18%,#000 82%,transparent); }
.dnaBackdrop span { --rung:0; position:absolute; top:calc(var(--rung) * 8% - 4%); left:0; width:100%; height:18px; transform-style:preserve-3d; animation:dnaRung 3.2s ease-in-out infinite; animation-delay:var(--delay); }
.dnaBackdrop span:before,.dnaBackdrop span:after { content:''; position:absolute; width:13px; height:13px; border-radius:50%; top:2px; background:#72ffa0; box-shadow:0 0 18px #48ed8680; }
.dnaBackdrop span:before { left:calc(50% + sin(var(--rung) * 0.65) * 30%); }
.dnaBackdrop span:after { left:calc(50% - sin(var(--rung) * 0.65) * 30%); background:#b7ff67; }
.dnaBackdrop span { background:linear-gradient(90deg,transparent 12%,#48ed8640 28%,#b7ff6755 50%,#48ed8640 72%,transparent 88%); height:1px; top:calc(var(--rung) * 8% + 2%); }
@keyframes dnaRung { 0%,100% { transform:translateX(0) scaleX(.55); opacity:.35; } 50% { transform:translateX(0) scaleX(1); opacity:1; } }
.heroCopy {
  padding: 55px 0 76px 6%;
  position: relative;
  z-index: 2;
}
.eyebrow {
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 800;
  color: var(--green);
  display: flex;
  align-items: center;
  gap: 9px;
}
.pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 5px #48ed861b;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  50% {
    box-shadow: 0 0 0 9px #48ed8600;
  }
}
h1,
h2,
h3,
p {
  margin-top: 0;
}
h1 {
  font:
    800 clamp(37px, 4.2vw, 60px)/1.08 Manrope,
    sans-serif;
  letter-spacing: -2.8px;
  margin: 23px 0 17px;
}
h1 em {
  font-style: normal;
  color: var(--green);
}
.heroCopy > p {
  max-width: 470px;
  font-size: 14px;
  line-height: 1.85;
  color: #aabbb0;
}
.heroBtns {
  display: flex;
  gap: 12px;
  margin-top: 28px;
}
.primary,
.secondary {
  min-height: 46px;
  padding: 0 17px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-size: 12px;
  font-weight: 800;
  transition:
    transform 0.2s,
    box-shadow 0.2s;
}
.primary {
  background: var(--green);
  color: #07120a;
  border: 1px solid var(--green);
  box-shadow: 0 8px 30px #48ed861a;
}
.primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 32px #48ed8638;
}
.secondary {
  background: #ffffff08;
  color: #e2eee5;
  border: 1px solid #b5d7bb32;
}
.trustRow {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  margin-top: 35px;
  color: #a9c0ae;
  font-size: 10px;
}
.trustRow span {
  display: flex;
  align-items: center;
  gap: 6px;
}
.trustRow svg {
  width: 15px;
  height: 15px;
  color: var(--green);
}
.heroVisual {
  position: relative;
  min-height: 370px;
  display: grid;
  place-items: center;
}
.heroImage {
  position: absolute;
  inset: 12px 4% 30px 0;
  background:
    linear-gradient(90deg, #102619 0%, #10261900 35%),
    linear-gradient(0deg, #10261966, transparent 40%),
    url('https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1100&q=90')
      center/cover;
  border-radius: 20px;
  opacity: 0.83;
  mask-image: linear-gradient(
    90deg,
    transparent 0%,
    black 18%,
    black 90%,
    transparent 100%
  );
}
.orbit {
  position: absolute;
  border: 1px solid #6ef19535;
  border-radius: 50%;
  transform: rotate(-25deg);
  pointer-events: none;
}
.orbitOne {
  width: 360px;
  height: 230px;
}
.orbitTwo {
  width: 285px;
  height: 340px;
  transform: rotate(50deg);
}
.floatCard {
  position: absolute;
  bottom: 65px;
  left: 7%;
  display: flex;
  align-items: center;
  gap: 12px;
  background: #0a160fdf;
  border: 1px solid #86c99836;
  padding: 13px 16px;
  border-radius: 15px;
  box-shadow: 0 15px 40px #0005;
  backdrop-filter: blur(12px);
  animation: float 5s ease-in-out infinite;
}
.floatIcon,
.promoIcon {
  width: 39px;
  height: 39px;
  border-radius: 12px;
  background: #48ed8618;
  color: var(--green);
  display: grid;
  place-items: center;
}
.floatCard b,
.floatCard small {
  display: block;
}
.floatCard b {
  font-size: 11px;
}
.floatCard small {
  font-size: 10px;
  color: var(--muted);
  margin-top: 5px;
}
.verified {
  color: var(--green);
  width: 16px;
}
.heroTag {
  position: absolute;
  right: 6%;
  top: 20%;
  display: flex;
  gap: 8px;
  align-items: center;
  background: #0b1b11cc;
  border: 1px solid #74d78b35;
  border-radius: 13px;
  padding: 12px;
  font-size: 10px;
  line-height: 1.6;
  color: #d5e9d8;
}
.heroTag svg {
  color: var(--green);
  width: 24px;
  height: 24px;
}
@keyframes float {
  50% {
    transform: translateY(-8px);
  }
}
.heroBottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 45px;
  border-top: 1px solid #a7d9ad1c;
  background: #07140ca6;
  display: flex;
  gap: 28px;
  align-items: center;
  padding: 0 6%;
  font-size: 10px;
  color: #9eb3a2;
}
.heroBottom span {
  display: flex;
  gap: 8px;
  align-items: center;
}
.greenDot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
}
.searchbar {
  margin: 27px 5.5% 0;
  height: 56px;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 0 18px;
  border: 1px solid var(--line);
  background: #0e1911;
  border-radius: 14px;
  color: #88a291;
}
.searchbar svg {
  width: 18px;
}
.searchbar input {
  flex: 1;
  min-width: 0;
  background: none;
  border: 0;
  outline: none;
  color: #f2fff3;
  font-size: 13px;
}
.searchbar input::placeholder {
  color: #75897a;
}
.searchbar > span {
  font-size: 10px;
  border: 1px solid var(--line);
  padding: 4px 7px;
  border-radius: 5px;
}
.section {
  padding: 65px 5.5% 0;
}
.sectionHead {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
}
.sectionHead h2,
.why h2,
.blog h2 {
  font:
    800 28px/1.2 Manrope,
    sans-serif;
  letter-spacing: -1px;
  margin: 12px 0 9px;
}
.sectionHead p,
.why p,
.blog > div > p {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 0;
}
.textLink {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--green);
  font-size: 11px;
  font-weight: 700;
  padding-bottom: 4px;
}
.filters {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
  margin: 24px 0 20px;
}
.filter {
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #0e1911;
  color: #b6c8b9;
  padding: 10px 14px;
  font-size: 11px;
}
.filter.active {
  background: #163923;
  border-color: #3bc56a;
  color: #a9ffbd;
}
.testGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 17px;
}
.testCard {
  background: linear-gradient(145deg, #122017, #0d1710);
  border: 1px solid var(--line);
  border-radius: 17px;
  overflow: hidden;
  transition:
    transform 0.25s,
    border-color 0.25s;
  animation: rise 0.45s both;
}
.testCard:hover {
  transform: translateY(-5px);
  border-color: #54d77c80;
}
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.testImage { height:170px; position:relative; overflow:hidden; isolation:isolate; background:radial-gradient(circle at 72% 24%,#7dffa44a,transparent 28%),radial-gradient(circle at 25% 75%,#b7ff672b,transparent 35%),linear-gradient(135deg,#173b26,#07150d 70%); }
.testImage img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; display:block; z-index:0; transition:transform .8s cubic-bezier(.2,.8,.2,1),filter .5s; }
.testImage:after { content:''; position:absolute; inset:0; z-index:1; pointer-events:none; background:linear-gradient(180deg,#06140b0a 15%,#06140b12 42%,#031209dc 100%),linear-gradient(115deg,#07160c22,transparent 55%); }
.medicalArt { position:absolute; z-index:0; inset:0; overflow:hidden; background:transparent; }
.artOrbLogo { position:absolute; width:56px; height:56px; max-width:24%; max-height:78%; object-fit:contain; right:calc(8% + 108px); top:calc(27% + 9px); z-index:2; transform-origin:50% 50%; filter:drop-shadow(0 5px 12px #0009); animation:none; }
.artRing { position:absolute; width:160px;height:74px;right:8%;top:27%;border:2px solid #ff2438d9;border-radius:50%;transform:rotate(-32deg);box-shadow:0 0 18px #ff183c88,inset 0 0 12px #ff183c33;animation:ringTurn 10s linear infinite; }
.artCross { position:absolute;right:29%;top:24%;font-size:58px;font-weight:200;color:#ff3348;text-shadow:0 0 25px #ff183c80;opacity:.8; }
.artLabel { position:absolute;left:14px;bottom:14px;color:#ffe0e3;font-size:9px;letter-spacing:3px;font-weight:800; }
.visual-diabetes .artOrbLogo,.visual-thyroid .artOrbLogo,.visual-vitd .artOrbLogo,.visual-full .artOrbLogo,.visual-lft .artOrbLogo { animation:none; }



@keyframes orbFloat { 0%,100% { transform:translateY(0) scale(1); } 50% { transform:translateY(-4px) scale(1.01); } }
@keyframes ringTurn { from { transform:rotate(-32deg) scale(1); } to { transform:rotate(328deg) scale(1.05); } }
.testImage > span {
  position: absolute;
  top: 13px;
  left: 13px;
  padding: 6px 9px;
  border: 1px solid #ffffff26;
  background: #06150dcf;
  border-radius: 7px;
  color: #b6ffc7;
  font-size: 9px;
  font-weight: 800;
}
.quickAdd {
  position: absolute;
  right: 13px;
  bottom: 13px;
  width: 34px;
  height: 34px;
  border-radius: 11px;
  border: 1px solid #a8f6b859;
  background: #0c2115e8;
  color: var(--green);
  font-size: 23px;
  line-height: 1;
}
.testInfo {
  padding: 16px;
}
.testInfo > small {
  color: #76c98d;
  letter-spacing: 1.4px;
  font-size: 8px;
  font-weight: 800;
}
.testInfo h3 {
  font:
    700 15px Manrope,
    sans-serif;
  margin: 9px 0 6px;
  letter-spacing: -0.3px;
}
.testInfo p {
  color: #8fa393;
  font-size: 11px;
  margin-bottom: 18px;
}
.priceRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.priceRow > div {
  display: flex;
  align-items: baseline;
  gap: 7px;
  flex-wrap: wrap;
}
.priceRow b {
  font:
    800 17px Manrope,
    sans-serif;
  color: #f0fff2;
}
.priceRow del {
  font-size: 10px;
  color: #728376;
}
.addBtn {
  background: #163c23;
  color: #a9ffbd;
  border: 1px solid #3b985650;
  border-radius: 9px;
  padding: 9px 10px;
  font-size: 10px;
  font-weight: 800;
  white-space: nowrap;
}
.addBtn.selected {
  background: var(--green);
  color: #06110a;
  border-color: var(--green);
}
.heroMetrics{display:flex;gap:27px;margin-top:25px}.heroMetrics>div{display:flex;flex-direction:column;gap:4px;padding-right:22px;border-right:1px solid var(--line)}.heroMetrics>div:last-child{border:0}.heroMetrics b{font:800 21px Manrope,sans-serif;color:var(--green)}.heroMetrics small{font-size:9px;color:var(--muted)}.packageStrip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:22px}.packageStrip>div{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:22px;border-radius:16px;background:linear-gradient(145deg,#13271a,#0d1710);border:1px solid var(--line);transition:transform .25s,border-color .25s}.packageStrip>div:hover{transform:translateY(-4px);border-color:#54d77c80}.packageStrip span{font-size:8px;letter-spacing:1.4px;color:var(--green);font-weight:800}.packageStrip b{font:700 16px Manrope,sans-serif}.packageStrip small{color:var(--muted);font-size:10px}.packageStrip button{display:flex;align-items:center;gap:7px;background:none;border:0;padding:0;color:var(--green);font-size:10px;font-weight:800;margin-top:7px}.tipsGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:22px}.tipCard{padding:22px;border:1px solid var(--line);background:#0e1911;border-radius:16px}.tipEmoji{display:grid;place-items:center;width:42px;height:42px;background:#163823;border-radius:13px;font-size:22px;margin-bottom:16px}.tipCard h3{font:700 14px/1.5 Manrope,sans-serif;margin-bottom:8px}.tipCard p{font-size:11px;line-height:1.8;color:var(--muted);margin:0}.clinicDetails{margin:25px 5.5% 0;padding:30px;display:grid;grid-template-columns:100px 1fr;gap:25px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(120deg,#13271a,#0d1710)}.clinicMark{width:90px;height:90px;border:1px solid #47d977;border-radius:25px;display:grid;place-items:center;background:#0b1710;font:800 28px Manrope,sans-serif;color:white;letter-spacing:-2px}.clinicMark span{color:var(--green)}.clinicCopy h2{font:800 25px Manrope,sans-serif;margin:12px 0}.clinicCopy p{font-size:11px;line-height:1.8;color:var(--muted);margin:6px 0}.clinicChips{display:flex;gap:9px;flex-wrap:wrap;margin:17px 0 20px}.clinicChips span{display:flex;align-items:center;gap:7px;padding:9px 11px;border:1px solid var(--line);border-radius:9px;color:#bcd0c0;font-size:10px}.clinicChips svg{width:14px;height:14px;color:var(--green)}.verificationNote{display:block;color:#859889;font-size:9px;line-height:1.7;margin-top:15px}.empty{padding:38px 15px;text-align:center;
  border: 1px dashed var(--line);
  border-radius: 14px;
  color: var(--muted);
  font-size: 13px;
}
.promoGrid {
  margin: 55px 5.5% 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13px;
}
.promoCard {
  display: flex;
  gap: 14px;
  padding: 21px 18px;
  background: #0e1b12;
  border: 1px solid var(--line);
  border-radius: 16px;
}
.promoIcon {
  flex-shrink: 0;
}
.promoCard h3 {
  font:
    700 13px Manrope,
    sans-serif;
  margin: 2px 0 7px;
}
.promoCard p {
  font-size: 10px;
  line-height: 1.7;
  color: var(--muted);
  margin-bottom: 14px;
}
.promoCard button,
.promoCard a {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: 0;
  padding: 0;
  color: var(--green);
  font-size: 10px;
  font-weight: 800;
}
.why {
  margin: 68px 5.5% 0;
  padding: 34px;
  background: linear-gradient(115deg, #12271a, #0e1911);
  border: 1px solid var(--line);
  border-radius: 20px;
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 35px;
  align-items: center;
}
.why h2 {
  max-width: 350px;
}
.why p {
  max-width: 410px;
}
.whyPoints {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}
.whyPoints > div {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.whyPoints svg {
  color: var(--green);
  width: 21px;
  height: 21px;
}
.whyPoints b {
  font-size: 11px;
}
.whyPoints span {
  font-size: 10px;
  line-height: 1.6;
  color: var(--muted);
}
.blog {
  padding: 65px 5.5%;
  display: grid;
  grid-template-columns: 1.1fr 1fr 1fr;
  gap: 15px;
  align-items: stretch;
}
.blogCard {
  padding: 22px;
  border: 1px solid var(--line);
  background: #0e1911;
  border-radius: 15px;
}
.blogCard > span {
  color: var(--green);
  font-size: 8px;
  letter-spacing: 1.5px;
  font-weight: 800;
}
.blogCard h3 {
  font:
    700 15px Manrope,
    sans-serif;
  margin: 15px 0 9px;
}
.blogCard p {
  font-size: 11px;
  line-height: 1.8;
  color: var(--muted);
}
.blogCard a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--green);
  font-size: 10px;
  font-weight: 800;
}
footer {
  padding: 25px 5.5% 90px;
  border-top: 1px solid var(--line);
  display: flex;
  align-items: center;
  gap: 25px;
  flex-wrap: wrap;
}
footer > p {
  margin: 0;
  color: #a4b6a8;
  font-size: 11px;
}
footer > small {
  width: 100%;
  font-size: 9px;
  color: #75877a;
}
.mobileDock {
  display: none;
}
.overlay {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: #0009;
  backdrop-filter: blur(5px);
  display: flex;
  justify-content: flex-end;
}
.drawer {
  width: min(480px, 100%);
  height: 100%;
  overflow: auto;
  background: #0a150d;
  border-left: 1px solid #3d6e49;
  padding: 28px;
  box-shadow: -25px 0 80px #0007;
  animation: slide 0.25s ease-out;
}
@keyframes slide {
  from {
    transform: translateX(25px);
    opacity: 0.6;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}
.drawerHead {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
}
.drawerHead small {
  font-size: 9px;
  color: var(--green);
  letter-spacing: 1.5px;
  font-weight: 800;
}
.drawerHead h2 {
  font:
    800 23px Manrope,
    sans-serif;
  margin: 7px 0 0;
}
.cartLine {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 9px;
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
}
.cartLine b,
.cartLine small {
  display: block;
}
.cartLine > div:first-child b {
  font-size: 12px;
}
.cartLine small {
  font-size: 10px;
  color: var(--muted);
  margin-top: 5px;
}
.cartLine strong {
  grid-column: 1;
  font-size: 13px;
  color: var(--green);
}
.stepper {
  display: flex;
  align-items: center;
  gap: 12px;
}
.stepper button {
  width: 27px;
  height: 27px;
  border-radius: 8px;
  background: #14271a;
  border: 1px solid var(--line);
  color: #eaffed;
}
.stepper b {
  font-size: 11px;
}
.totalRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 0 10px;
  font-size: 13px;
}
.totalRow b {
  font: 800 23px Manrope;
  color: var(--green);
}
.note {
  font-size: 10px;
  line-height: 1.7;
  color: #8ba18f;
  margin: 14px 0 20px;
}
.full {
  width: 100%;
  margin-top: 12px;
}
.formDrawer label {
  display: block;
  font-size: 11px;
  color: #b4c8b8;
  margin: 18px 0;
}
.formDrawer input,
.formDrawer textarea,
.formDrawer select {
  display: block;
  width: 100%;
  margin-top: 8px;
  padding: 13px 12px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #0f1c12;
  color: #eaffed;
  outline: none;
  font-size: 12px;
}
.formDrawer textarea {
  min-height: 80px;
  resize: vertical;
}
.formDrawer input:focus,
.formDrawer textarea:focus,
.formDrawer select:focus {
  border-color: #49d975;
}
.locMsg,
.statusMsg {
  font-size: 11px;
  line-height: 1.6;
  color: var(--green);
  padding: 10px;
  background: #15301c;
  border-radius: 9px;
}
.coord {
  display: block;
  color: #a5e8b5;
  margin: 8px 0;
}
.trackSteps {
  margin-top: 22px;
  border-left: 1px solid #3c754a;
  padding-left: 18px;
  display: grid;
  gap: 18px;
}
.trackSteps span {
  font-size: 11px;
  color: #a4b9a8;
  display: flex;
  gap: 9px;
  align-items: center;
}
.trackSteps i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #4be982;
  display: inline-block;
  margin-left: -22px;
  box-shadow: 0 0 0 4px #14351f;
}
@media (max-width: 1000px) {
  .header nav {
    gap: 14px;
  }
  .hero {
    grid-template-columns: 1.05fr 0.95fr;
  }
  .heroCopy {
    padding-top: 45px;
  }
  .trustRow {
    gap: 11px;
  }
  .testGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .why {
    grid-template-columns: 1fr;
  }
  .promoGrid {
    grid-template-columns: 1fr;
  }
  .promoCard {
    padding: 18px;
  }
  .blog {
    grid-template-columns: 1fr 1fr;
  }
  .blog > div:first-child {
    grid-column: 1/-1;
  }
}
@media(max-width:650px){.heroMetrics{gap:12px;margin-top:22px}.heroMetrics>div{padding-right:11px}.heroMetrics b{font-size:17px}.heroMetrics small{font-size:8px}.packageStrip,.tipsGrid{grid-template-columns:1fr}.packageStrip>div{padding:17px}.clinicDetails{margin:25px 4% 0;padding:20px;grid-template-columns:1fr;gap:15px}.clinicMark{width:62px;height:62px;border-radius:17px;font-size:20px}.clinicCopy h2{font-size:21px}.clinicChips{gap:7px}.topline {
    padding: 0 5%;
    font-size: 9px;
  }
  .topline span:last-child {
    display: none;
  }
  .header {
    height: 70px;
    padding: 0 5%;
  }
  .brand {
    gap: 8px;
  }
  .logo {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    font-size: 15px;
  }
  .brand b {
    font-size: 12px;
  }
  .brand small {
    font-size: 7px;
    letter-spacing: 1px;
  }
  .header nav {
    display: none;
  }
  .headActions .iconBtn {
    display: none;
  }
  .cartBtn {
    padding: 10px 11px;
    font-size: 11px;
  }
  .hero {
    margin: 14px 4% 0;
    display: block;
    min-height: 0;
    border-radius: 20px;
  }
  .heroCopy {
    padding: 33px 23px 80px;
  }
  .heroCopy h1 {
    font-size: 39px;
    letter-spacing: -2px;
  }
  .heroCopy > p {
    font-size: 12px;
    line-height: 1.8;
  }
  .heroBtns {
    flex-wrap: wrap;
  }
  .primary,
  .secondary {
    font-size: 11px;
    padding: 0 13px;
    min-height: 43px;
  }
  .trustRow {
    margin-top: 25px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .heroVisual {
    position: absolute;
    right: 0;
    top: 0;
    width: 42%;
    height: 180px;
    min-height: 0;
    opacity: 0.27;
    pointer-events: none;
  }
  .heroImage {
    inset: 0;
    background-position: 55% center;
  }
  .orbit,
  .floatCard,
  .heroTag {
    display: none;
  }
  .heroBottom {
    height: 40px;
    padding: 0 15px;
    gap: 13px;
    font-size: 8px;
    justify-content: space-between;
  }
  .searchbar {
    margin: 16px 4% 0;
    height: 50px;
    padding: 0 12px;
  }
  .searchbar input {
    font-size: 11px;
  }
  .searchbar > span {
    display: none;
  }
  .section {
    padding: 45px 4% 0;
  }
  .sectionHead h2,
  .why h2,
  .blog h2 {
    font-size: 23px;
  }
  .sectionHead p {
    font-size: 10px;
  }
  .textLink {
    font-size: 10px;
    white-space: nowrap;
  }
  .filters {
    gap: 7px;
    margin: 19px 0 15px;
    overflow: auto;
    flex-wrap: nowrap;
    padding-bottom: 4px;
  }
  .filter {
    white-space: nowrap;
    padding: 9px 12px;
    font-size: 10px;
  }
  .testGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .testImage {
    height: 125px;
  }
  .testInfo {
    padding: 12px;
  }
  .testInfo h3 {
    font-size: 12px;
    line-height: 1.45;
  }
  .testInfo p {
    font-size: 10px;
    min-height: 28px;
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .priceRow {
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
  }
  .priceRow b {
    font-size: 16px;
  }
  .addBtn {
    width: 100%;
    padding: 10px 6px;
  }
  .quickAdd {
    width: 30px;
    height: 30px;
  }
  .promoGrid {
    margin: 35px 4% 0;
    gap: 9px;
  }
  .promoCard {
    padding: 15px;
    gap: 12px;
  }
  .why {
    margin: 40px 4% 0;
    padding: 22px;
    gap: 25px;
  }
  .whyPoints {
    gap: 9px;
  }
  .whyPoints b {
    font-size: 10px;
  }
  .whyPoints span {
    font-size: 9px;
  }
  .blog {
    padding: 43px 4%;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .blog > div:first-child {
    grid-column: auto;
  }
  .blogCard {
    padding: 18px;
  }
  .blogCard h3 {
    margin-top: 10px;
  }
  footer {
    padding: 22px 4% 90px;
    gap: 13px;
  }
  footer > p {
    font-size: 10px;
  }
  .mobileDock {
    display: flex;
    position: fixed;
    z-index: 15;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 9px 8px calc(9px + env(safe-area-inset-bottom));
    background: #08120bef;
    border-top: 1px solid var(--line);
    backdrop-filter: blur(16px);
    justify-content: space-around;
  }
  .mobileDock a,
  .mobileDock button {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #c4d6c8;
    font-size: 10px;
    font-weight: 700;
    background: none;
    border: 0;
  }
  .mobileDock svg {
    width: 16px;
    height: 16px;
    color: var(--green);
  }
  .drawer {
    padding: 23px 20px;
  }
  .drawerHead h2 {
    font-size: 21px;
  }
}
/* Live motion system: cinematic hero, 3D cards, image depth and a subtle scan beam */
.hero { isolation: isolate; }
.hero:after { content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 1; background: linear-gradient(115deg, transparent 35%, #7dff9a0b 48%, transparent 60%); transform: translateX(-120%); animation: heroSweep 8s ease-in-out infinite; }
@keyframes heroSweep { 0%, 35% { transform: translateX(-120%); } 75%, 100% { transform: translateX(120%); } }
.heroImage { animation: heroImageDrift 18s ease-in-out infinite alternate; transform-origin: center; will-change: transform, background-position; }
@keyframes heroImageDrift { from { transform: scale(1.02); background-position: 48% center; } to { transform: scale(1.12); background-position: 56% center; } }
.heroVisual .orbitOne { animation: orbitSpin 22s linear infinite; }
.heroVisual .orbitTwo { animation: orbitSpin 28s linear infinite reverse; }
@keyframes orbitSpin { from { rotate: 0deg; } to { rotate: 360deg; } }
.heroTag { animation: tagFloat 4.8s ease-in-out infinite; }
@keyframes tagFloat { 0%, 100% { transform: translate3d(0,0,0) rotate(0deg); } 50% { transform: translate3d(0,-9px,12px) rotate(1deg); } }
.floatCard { animation: float 4.2s ease-in-out infinite; }
.heroBottom { overflow: hidden; }
.heroBottom span { animation: statusGlow 3.5s ease-in-out infinite; }
.heroBottom span:nth-child(2) { animation-delay: .5s; }
.heroBottom span:nth-child(3) { animation-delay: 1s; }
@keyframes statusGlow { 0%, 100% { color: #9eb3a2; } 50% { color: #caffd4; text-shadow: 0 0 14px #48ed8645; } }
.testCard, .packageStrip > div, .tipCard, .promoCard, .blogCard { transform-style: preserve-3d; perspective: 1000px; transition: transform .45s cubic-bezier(.2,.8,.2,1), border-color .35s, box-shadow .35s; }
.testCard:hover { transform: perspective(1000px) translateY(-8px) rotateX(2deg) rotateY(-2deg); box-shadow: 0 22px 45px #0007, 0 0 0 1px #54d77c20; }
.testImage { overflow: hidden; transform: translateZ(0); }
.testImage:after { content: ''; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 25%, #ffffff20 45%, transparent 62%); transform: translateX(-130%); transition: transform .8s ease; pointer-events: none; }
.testCard:hover .testImage:after { transform: translateX(130%); }
.testCard:hover .testImage img { transform:scale(1.13); filter:saturate(1.18) contrast(1.04); }
.testCard:hover .medicalArt { transform:translateZ(20px); }
.medicalArt { transition:transform .5s ease; }
.testCard:hover .testImage { background-size: 112% auto; }
.testImage { transition: background-size .65s ease, filter .45s ease; background-size: 100% auto; }
.testCard:hover .testInfo { transform: translateZ(12px); }
.testInfo { transition: transform .4s ease; }
.packageStrip > div:hover, .tipCard:hover, .promoCard:hover, .blogCard:hover { transform: perspective(1000px) translateY(-6px) rotateX(1deg); border-color: #54d77c80; box-shadow: 0 18px 35px #0005; }
.packageStrip > div:before, .tipCard:before, .promoCard:before, .blogCard:before { content: ''; display: block; height: 2px; width: 36px; margin-bottom: 2px; background: linear-gradient(90deg, var(--green), transparent); opacity: .75; }
.pulse { animation: pulse 1.7s infinite, liveGlow 2.6s ease-in-out infinite; }
@keyframes liveGlow { 50% { box-shadow: 0 0 0 5px #48ed861b, 0 0 20px #48ed8680; } }
@media (max-width: 650px) { .heroImage { animation-duration: 22s; } .testCard:hover { transform: translateY(-4px); } }
/* Cinematic black finish — DSD green is an accent, not the whole canvas. */
body,.app { background-color:#050606; }
.topline { background:#090a09; color:#9ca49f; border-bottom:1px solid #ffffff0b; }
.header { background:rgba(5,6,6,.88); border-bottom-color:#ffffff14; }
.hero { background:radial-gradient(ellipse at 78% 28%,#26332a38,transparent 34%),linear-gradient(115deg,#080909 0%,#111312 48%,#070808 100%); border-color:#48ed8630; box-shadow:0 28px 90px #000a, inset 0 1px #ffffff08; }
.hero:before { background:radial-gradient(circle at 75% 35%,#48ed860d,transparent 43%); }
.dnaBackdrop { opacity:.24; filter:saturate(.7); }
.hero h1,.section h2,.clinicCopy h2,.why h2,.blog h2 { text-shadow:0 5px 28px #000; }
.testCard,.packageStrip>div,.tipCard,.promoCard,.blogCard,.clinicDetails { background:linear-gradient(145deg,#121413,#090a09 72%); border-color:#ffffff14; box-shadow:0 16px 42px #0007; }
.testImage { background:radial-gradient(circle at 72% 24%,#48ed861e,transparent 28%),linear-gradient(135deg,#191d1a,#080909 70%); }
.testImage:after { background:linear-gradient(180deg,#05060605 10%,#05060615 40%,#050606ed 100%),linear-gradient(115deg,#ffffff06,transparent 55%); }
.logo { background:linear-gradient(145deg,#171a18,#080908); border-color:#48ed8670; box-shadow:0 0 24px #48ed8610; }
.primary,.cartBtn { box-shadow:0 8px 28px #48ed8615; }
.clinicPhotoWrap { position:relative; min-width:260px; max-width:360px; min-height:260px; border-radius:20px; overflow:hidden; background:radial-gradient(circle at 50% 35%,#1a2a20,#080909 72%); border:1px solid #ffffff19; }
.clinicPhotoWrap>img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:saturate(.72) contrast(1.08); }
.clinicPhotoWrap:after { content:''; position:absolute; inset:0; background:linear-gradient(180deg,#05060605 25%,#050606c9 100%); pointer-events:none; }
.clinicPhotoWrap .clinicMark { position:absolute; z-index:2; bottom:18px; left:18px; background:#070908dd; border:1px solid #48ed8655; box-shadow:0 8px 35px #0009; }
.listingRating { display:flex; flex-wrap:wrap; gap:10px; align-items:center; color:#b4bdb7; font-size:12px; margin:14px 0 18px; }
.listingRating strong { color:#e9f4ec; font-size:15px; }
.listingRating strong:first-letter { color:#48ed86; }
.ratingDivider { color:#566059; }
.clinicActions { display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-top:18px; }
.clinicActions .secondary { display:inline-flex; align-items:center; gap:8px; }
.officialEmail { color:#a9b5ad; font-size:13px; margin-top:14px; }
@media(max-width:700px) { .clinicDetails { display:flex; flex-direction:column; } .clinicPhotoWrap { max-width:none; width:100%; min-height:220px; } .topline span:last-child { display:none; } .listingRating { gap:7px; } }
@media (prefers-reduced-motion: reduce) { *, *:before, *:after { animation-duration:0.01ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important; transition-duration:0.01ms !important; } }

/* 3D rotating package advertising deck */
.heroPackageDeck { position:relative; z-index:3; width:280px; height:320px; perspective:1100px; transform-style:preserve-3d; }
.heroPackageCard { position:absolute; inset:18px 12px 24px; padding:14px; display:flex; flex-direction:column; gap:9px; border:1px solid #8bf5a566; border-radius:18px; background:linear-gradient(145deg,#171d19f2,#080b09f5); box-shadow:0 24px 65px #000a, inset 0 1px #ffffff1a; overflow:hidden; backdrop-filter:blur(16px); animation:packageShow 8.4s ease-in-out infinite; transform-style:preserve-3d; }
.heroPackageCard-0 { z-index:3; --tilt:-3deg; animation-delay:0s; }
.heroPackageCard-1 { z-index:2; --tilt:5deg; animation-delay:-2.8s; }
.heroPackageCard-2 { z-index:1; --tilt:-7deg; animation-delay:-5.6s; }
.heroPackagePhoto { height:145px; flex-shrink:0; border-radius:11px; background-size:cover; background-position:center; position:relative; overflow:hidden; }
.heroPackagePhoto:after { content:''; position:absolute; inset:0; background:linear-gradient(180deg,#03060400,#030604b5); }
.heroPackageCard>span { color:#7df29a; font-size:8px; font-weight:800; letter-spacing:1.5px; }
.heroPackageCard>b { font:700 14px/1.3 Manrope,sans-serif; color:#f2fff5; }
.heroPackageCard>strong { color:#baff76; font:800 25px Manrope,sans-serif; }
.heroPackageCard>small { color:#b7c5bb; font-size:9px; }
@keyframes packageShow { 0%,100% { transform:translate3d(20px,8px,-35px) rotateY(-17deg) rotateX(3deg) scale(.86); opacity:.48; } 12%,28% { transform:translate3d(-3px,0,25px) rotateY(-4deg) rotateX(1deg) scale(1); opacity:1; } 38%,64% { transform:translate3d(-10px,-5px,0) rotateY(4deg) rotateX(0) scale(.96); opacity:.82; } 78% { transform:translate3d(16px,8px,-30px) rotateY(14deg) rotateX(-2deg) scale(.88); opacity:.5; } }
.sourceNote { margin-top:14px; color:#9eaaa2; font-size:10px; line-height:1.7; }
.sourceLinks { display:flex; flex-wrap:wrap; gap:9px; margin:14px 0 4px; }
.sourceLinks a { padding:8px 10px; border:1px solid #ffffff1b; border-radius:9px; color:#b8ffca; font-size:10px; background:#0a0c0b; }
.sourceLinks a:hover { border-color:#48ed8670; }
@media(max-width:650px) { .heroPackageDeck { width:190px; height:205px; transform:scale(.92); transform-origin:top right; } .heroPackageCard { inset:6px 2px 10px; padding:8px; gap:5px; border-radius:12px; } .heroPackagePhoto { height:80px; border-radius:8px; } .heroPackageCard>span { font-size:6px; letter-spacing:.8px; } .heroPackageCard>b { font-size:9px; } .heroPackageCard>strong { font-size:17px; } .heroPackageCard>small { font-size:7px; } .heroPackageVisual .heroImage { opacity:.4; } .sourceLinks a { font-size:9px; } }
@media(prefers-reduced-motion:reduce) { .heroPackageCard { animation:none; opacity:1; transform:none; } }

/* DSD brand system: medical blue, DNA red, and diagnostic teal. */
:root { --green:#168a78; --lime:#d91f35; --muted:#8c9baa; --panel:#0c1b2c; --line:rgba(119,158,195,.22); color:#edf4fb; background:#06111e; }
body { background:radial-gradient(ellipse at 76% -10%,#123d5d 0%,transparent 38%),radial-gradient(ellipse at 10% 45%,#0a243b 0%,transparent 42%),#06111e; color:#edf4fb; }
.topline { background:#081a2b; color:#c0d3e4; }
.topline svg,.trustRow svg,.heroTag svg,.verified { color:#168a78; }
.header { background:rgba(6,17,30,.92); border-bottom-color:#5c89ad35; }
.logoImage { width:190px; height:58px; object-fit:contain; display:block; }
.brand { min-width:0; }
.brand b { color:#f2f7fc; }
.brand small { color:#6eb5d4; }
.hero { background:linear-gradient(118deg,#071727 0%,#0b2942 56%,#071727 100%); border-color:#168a7855; box-shadow:0 28px 90px #0008,inset 0 1px #ffffff0b; }
.hero:before { background:radial-gradient(circle at 75% 35%,#168a781f,transparent 43%); }
.heroCopy { z-index:4; }
.heroCopy h1 em { color:#ef5364; }
.eyebrow { color:#54c6b2; }
.pulse { background:#168a78; box-shadow:0 0 0 5px #168a781b; }
.primary,.cartBtn { background:#168a78; color:#fff; border-color:#168a78; box-shadow:0 8px 28px #168a7826; }
.primary:hover { box-shadow:0 12px 32px #168a7840; }
.secondary { color:#e4f0fa; border-color:#8bb6d33b; background:#ffffff08; }
.heroImage { opacity:.24; mask-image:linear-gradient(90deg,transparent 0%,#000 10%,#000 95%,transparent 100%); }
.heroPackageDeck { position:relative; z-index:5; width:min(350px,90%); height:370px; perspective:1300px; transform-style:preserve-3d; }
.heroPackageCard { inset:12px 8px 16px; padding:16px; gap:10px; border:1px solid #66cbbf88; border-radius:22px; background:linear-gradient(150deg,#123a55f7,#071625fc 78%); box-shadow:0 28px 70px #000b,inset 0 1px #ffffff22; backdrop-filter:blur(18px); animation:packageSpotlight 12s cubic-bezier(.22,.72,.18,1) infinite; opacity:0; visibility:hidden; pointer-events:none; }
.heroPackageCard-0 { z-index:3; animation-delay:0s; }
.heroPackageCard-1 { z-index:3; animation-delay:4s; }
.heroPackageCard-2 { z-index:3; animation-delay:8s; }
.heroPackagePhoto { height:170px; border:1px solid #ffffff1c; background-position:center; background-size:cover; box-shadow:inset 0 -28px 35px #06111e70; }
.heroPackageCard>span { color:#75d9ca; font-size:9px; letter-spacing:1.8px; }
.heroPackageCard>b { color:#f5f9ff; font-size:17px; line-height:1.35; }
.heroPackageCard>strong { color:#ff6675; font-size:29px; }
.heroPackageCard>small { color:#b5cadb; font-size:10px; }
.heroCardAction { align-self:flex-start; display:inline-flex; align-items:center; gap:7px; margin-top:auto; color:#b8f2e9; font-size:11px; font-weight:800; }
@keyframes packageSpotlight { 0%,4% { opacity:0; visibility:hidden; transform:translate3d(36px,12px,-60px) rotateY(-18deg) rotateX(4deg) scale(.86); } 9%,27% { opacity:1; visibility:visible; transform:translate3d(0,0,28px) rotateY(-3deg) rotateX(1deg) scale(1); } 32%,36% { opacity:0; visibility:hidden; transform:translate3d(-30px,-4px,-40px) rotateY(16deg) rotateX(-3deg) scale(.9); } 100% { opacity:0; visibility:hidden; } }
.heroPackageCard-1 { animation-delay:4s; }
.heroPackageCard-2 { animation-delay:8s; }
.heroBottom { background:#071a2bbf; border-top-color:#6bb9d326; }
.searchbar { background:#0b2032; border-color:#6c9bbc38; color:#82c9dd; }
.testCard,.packageStrip>div,.tipCard,.promoCard,.blogCard,.clinicDetails { background:linear-gradient(145deg,#10283b,#081522 76%); border-color:#7ca7c325; box-shadow:0 18px 42px #0006; }
.testInfo { background:linear-gradient(180deg,#10283b,#081522); }
.testInfo small,.packageStrip>div>span { color:#5bd0bd; }
.testImage>span { color:#e8f8ff; border-color:#168a7866; background:#071a2be8; }
.addBtn { border-color:#168a7866; background:#0c2b3b; color:#c4f5ed; }
.addBtn:hover,.addBtn.selected { background:#168a78; color:#fff; }
.priceRow b,.packageFeature strong { color:#f5f9ff; }
.packageStrip>div:hover,.tipCard:hover,.promoCard:hover,.blogCard:hover { border-color:#d91f356b; }
.packageStrip>div:before,.tipCard:before,.promoCard:before,.blogCard:before { background:linear-gradient(90deg,#168a78,#d91f35,transparent); }
.clinicPhotoWrap { background:radial-gradient(circle at 50% 35%,#164b67,#081522 72%); border-color:#7ca7c333; }
.clinicPhotoWrap .clinicMark { background:#071a2be8; border-color:#168a7866; }
.listingRating strong:first-letter { color:#168a78; }
.sourceLinks a { color:#b8f2e9; background:#091b2a; border-color:#7ca7c333; }
.formDrawer input,.formDrawer textarea,.formDrawer select { background:#091b2a; color:#edf4fb; border-color:#7ca7c333; }
.locMsg,.statusMsg { color:#b8f2e9; background:#0c2c3b; }
.cartLine strong,.totalRow b { color:#54c6b2; }
.stepper button { background:#0c2b3b; color:#edf4fb; }
.note { color:#9db4c5; }
.mobileDock { background:#06111ef2; border-top-color:#6c9bbc38; }
.mobileDock svg { color:#54c6b2; }
@media(max-width:650px){.cardEditQuick{opacity:1;}}
@media(prefers-reduced-motion:reduce) { .heroPackageCard { animation:none!important; opacity:1!important; visibility:visible!important; transform:none!important; position:relative; margin-bottom:10px; } .heroPackageDeck { height:auto; } }

/* Legibility and package-led imagery polish */
.sectionHead h2,.testInfo h3,.packageStrip b,.tipCard h3,.promoCard h3,.blogCard h3,.clinicCopy h2,.why h2 { color:#f4f7f4; }
.sectionHead p,.testInfo p,.packageStrip small,.tipCard p,.promoCard p,.blogCard p,.why p { color:#b2bcb5; }
.testInfo small,.packageStrip>div>span { color:#75e99a; }
.testCard { overflow:hidden; background:#0c0e0d; border:1px solid #ffffff1b; }
.testImage { position:relative; isolation:isolate; background-color:#101412; }
.testImage img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; filter:saturate(.82) contrast(1.08); opacity:.93; transition:transform .55s ease,filter .4s ease; }
.testImage .medicalArt { position:absolute; inset:0; z-index:1; pointer-events:none; }
.testImage>span { z-index:3; background:#080b09e8; color:#d9ffe4; border:1px solid #48ed8640; border-radius:999px; padding:6px 9px; font-size:9px; }
.testImage .quickAdd { z-index:4; }
.testInfo { background:linear-gradient(180deg,#111312,#090a09); }
.priceRow b { color:#f5fff7; }
.priceRow del,.packageStrip del { color:#87918a; font-size:11px; margin-left:6px; }
.addBtn { border:1px solid #48ed8655; background:#111b14; color:#caffd5; }
.addBtn:hover,.addBtn.selected { background:#48ed86; color:#071009; }
.packageStrip { gap:16px; }
.packageStrip .packageFeature { position:relative; overflow:hidden; min-height:270px; padding:0 20px 20px; display:flex; flex-direction:column; align-items:flex-start; gap:9px; }
.packageFeature .featurePhoto { width:calc(100% + 40px); height:132px; margin:0 -20px 8px; background-size:cover; background-position:center; position:relative; }
.packageFeature .featurePhoto:after { content:''; position:absolute; inset:0; background:linear-gradient(180deg,#05060608 15%,#090a09 100%); }
.packageFeature b { font-size:16px; line-height:1.4; }
.packageFeature strong { color:#f5fff7; font-size:19px; margin-top:2px; }
.packageFeature button { margin-top:auto; }
.heroCopy>p { color:#c1c9c3; max-width:560px; line-height:1.9; }
.topline { color:#c0c8c2; }
.verificationNote { color:#a5b0a8; }
@media(max-width:650px) { .packageStrip .packageFeature { min-height:250px; } .packageFeature .featurePhoto { height:155px; } .testImage { height:145px; } .testInfo { padding:13px 11px; } .testInfo h3 { color:#f5f7f5; font-size:12px; } .testInfo p { color:#b7c0ba; } .priceRow b { font-size:16px; } .sectionHead { gap:10px; align-items:flex-start; } .clinicActions>* { width:100%; justify-content:center; } }

/* Build 1 brand lock: match the supplied DSD blue, DNA red and teal across all UI surfaces. */
:root {
  --dsd-blue: #0876d1;
  --dsd-blue-deep: #061b31;
  --dsd-red: #e1263b;
  --dsd-teal: #078b83;
  --green: var(--dsd-teal);
  --lime: var(--dsd-red);
  --muted: #a8bbcb;
  --panel: #0b2339;
  --line: rgba(117, 174, 214, .24);
}
body, .app {
  color: #eef7ff;
  background: radial-gradient(ellipse at 78% -8%, #12466b 0%, transparent 38%), radial-gradient(ellipse at 8% 42%, #0a2b49 0%, transparent 44%), #061525;
}
.topline { background: #071a2d; color: #c8deef; }
.topline svg, .trustRow svg, .heroTag svg, .verified, .mobileDock svg { color: var(--dsd-teal); }
.header { background: rgba(5, 20, 36, .94); border-bottom-color: #5b9bc733; }
.brand > div { display: none; }
.logoImage { width: 224px; height: 70px; object-fit: contain; display: block; }
.brand { min-width: 0; gap: 0; }
.brand b { color: #f4f9ff; }
.brand small { color: #83c9e6; }
.hero { background: linear-gradient(118deg, #07182a 0%, #0b2b48 56%, #07182a 100%); border-color: #078b8366; }
.hero:before { background: radial-gradient(circle at 75% 35%, #078b831f, transparent 43%); }
.heroCopy h1 em { color: #ff6475; }
.eyebrow, .textLink, .heroMetrics b { color: #65d2c6; }
.pulse { background: var(--dsd-red); box-shadow: 0 0 0 5px #e1263b24; }
.primary, .cartBtn { background: linear-gradient(115deg, #0876d1, #078b83); color: #fff; border-color: #168fba; box-shadow: 0 8px 28px #0876d133; }
.primary:hover { box-shadow: 0 12px 32px #0876d155; }
.secondary { color: #eaf6ff; border-color: #8bb6d34a; background: #ffffff08; }
.iconBtn { background: #0a263d; color: #e5f4ff; border-color: #6b9fc344; }
.cartBtn b { background: #e1263b; color: #fff; }
.heroPackageCard { border-color: #3dbdb388; background: linear-gradient(150deg, #123c5bfa, #071727fd 78%); }
.heroPackageCard>span, .heroCardAction { color: #80e2d6; }
.heroPackageCard>strong { color: #ff6475; }
.heroBottom { background: #071a2bcf; border-top-color: #6bb9d333; color: #bdd2e2; }
.searchbar { background: #0a2237; border-color: #6c9bbc4d; color: #82c9dd; }
.searchbar input { color: #f2f8ff; }
.filter { background: #0b2338; color: #c0d5e5; border-color: #6c9bbc3b; }
.filter.active { background: #0b4c61; border-color: #078b83; color: #c4fff5; }
.testCard, .packageStrip>div, .tipCard, .promoCard, .blogCard, .clinicDetails {
  background: linear-gradient(145deg, #102d45, #081a2b 76%);
  border-color: #7ca7c333;
  box-shadow: 0 18px 42px #0006;
}
.testInfo { background: linear-gradient(180deg, #102d45, #081a2b); }
.testInfo h3, .packageStrip b, .tipCard h3, .promoCard h3, .blogCard h3, .clinicCopy h2, .why h2, .sectionHead h2 { color: #f3f8ff; }
.testInfo p, .packageStrip small, .tipCard p, .promoCard p, .blogCard p, .why p { color: #b2c6d7; }
.testInfo small, .packageStrip>div>span, .blogCard>span { color: #65d2c6; }
.testImage { background: radial-gradient(circle at 72% 24%, #0876d133, transparent 30%), linear-gradient(135deg, #103e5e, #071625 70%); }
.testImage:after { background: linear-gradient(180deg, #06152508 10%, #06152516 40%, #061525ed 100%), linear-gradient(115deg, #0876d122, transparent 55%); }
.testImage>span { color: #f1fbff; border-color: #078b8366; background: #071a2be8; }
.quickAdd { border-color: #5ad2c57a; background: #09263be8; color: #8be6dc; }
.addBtn { border-color: #078b8370; background: #0b2b40; color: #c4f5ed; }
.addBtn:hover, .addBtn.selected { background: var(--dsd-teal); color: #fff; border-color: var(--dsd-teal); }
.priceRow b, .packageFeature strong { color: #f5f9ff; }
.packageStrip>div:hover, .tipCard:hover, .promoCard:hover, .blogCard:hover { border-color: #e1263b80; }
.packageStrip>div:before, .tipCard:before, .promoCard:before, .blogCard:before { background: linear-gradient(90deg, #0876d1, #e1263b, #078b83, transparent); }
.floatCard { background: #081e31ed; border-color: #078b8366; }
.floatIcon, .promoIcon, .tipEmoji { background: #0b4350; color: #8be6dc; }
.heroTag { background: #081e31ed; border-color: #078b8366; }
.clinicPhotoWrap { background: radial-gradient(circle at 50% 35%, #164b67, #081522 72%); border-color: #7ca7c344; }
.clinicPhotoWrap .clinicMark { background: #071a2be8; border-color: #078b8366; }
.listingRating strong:first-letter { color: #e1263b; }
.sourceLinks a { color: #b8f2e9; background: #091b2a; border-color: #7ca7c344; }
.formDrawer input, .formDrawer textarea, .formDrawer select { background: #091b2a; color: #edf4fb; border-color: #7ca7c344; }
.locMsg, .statusMsg { color: #b8f2e9; background: #0c2c3b; }
.cartLine strong, .totalRow b { color: #65d2c6; }
.stepper button { background: #0c2b3b; color: #edf4fb; border-color: #6c9bbc44; }
.note { color: #adc2d2; }
.mobileDock { background: #061525f5; border-top-color: #6c9bbc44; }
footer { border-top-color: #6c9bbc33; }
footer .logoImage { width: 240px; height: 76px; }
@media (max-width: 650px) {
  .logoImage { width: 166px; height: 56px; }
  footer .logoImage { width: 190px; height: 62px; }
  .heroPackageCard>strong { color: #ff6475; }
}


/* ==========================================================================
   VITALITY ASSESSMENT PORTAL INTEGRATION STYLES
   ========================================================================== */

/* Section Anchor Spacing & Scroll Offset */
.vitalityScoreSection {
  scroll-margin-top: 96px;
  margin: 32px 5.5% 48px;
  position: relative;
}

/* Nav Link Polish */
.navVitalityLink {
  color: #48ed86 !important;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: all 200ms ease-out;
}
.navVitalityLink:hover {
  color: #72ff9f !important;
  text-shadow: 0 0 12px rgba(72, 237, 134, 0.4);
}
.sparkleIcon {
  color: #b7ff67;
  animation: pulse 2.5s infinite;
}

/* Hero Quiz CTA Button */
.heroQuizBtn {
  background: linear-gradient(135deg, #48ed86 0%, #10b981 100%) !important;
  color: #031509 !important;
  font-weight: 800 !important;
  border: 1px solid rgba(255, 255, 255, 0.25) !important;
  box-shadow: 0 0 24px rgba(72, 237, 134, 0.35), 0 8px 20px rgba(0, 0, 0, 0.4);
  transition: transform 180ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 180ms ease-out;
}
.heroQuizBtn:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 0 32px rgba(72, 237, 134, 0.55), 0 12px 28px rgba(0, 0, 0, 0.5);
}
.heroQuizBtn:active {
  transform: translateY(0) scale(0.98);
}

/* Glassmorphic Feedback Toast Banner */
.vitalityToastContainer {
  position: fixed;
  bottom: 28px;
  right: 28px;
  z-index: 100;
  animation: toastSlideUp 350ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.vitalityToastCard {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 18px;
  background: rgba(12, 22, 16, 0.92);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border: 1px solid rgba(72, 237, 134, 0.45);
  border-radius: 16px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(72, 237, 134, 0.25);
  max-width: 480px;
}

.vitalityToastIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: rgba(72, 237, 134, 0.12);
  flex-shrink: 0;
}

.vitalityToastContent {
  flex: 1;
  min-width: 0;
}

.vitalityToastTitle {
  font-size: 13px;
  font-weight: 700;
  color: #effff2;
  font-family: 'Manrope', sans-serif;
  display: flex;
  align-items: center;
  gap: 6px;
}

.vitalityToastDesc {
  font-size: 11px;
  color: #9cb8a3;
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.vitalityToastDesc b {
  color: #ffffff;
}

.vitalityToastCartBtn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  background: #48ed86;
  color: #051409;
  font-size: 11px;
  font-weight: 700;
  border-radius: 8px;
  border: none;
  white-space: nowrap;
  transition: all 150ms ease;
  flex-shrink: 0;
  cursor: pointer;
}
.vitalityToastCartBtn:hover {
  background: #64f39b;
  transform: scale(1.03);
}

.vitalityToastClose {
  background: transparent;
  border: none;
  color: #799781;
  padding: 4px;
  border-radius: 6px;
  display: grid;
  place-items: center;
  transition: color 150ms;
  cursor: pointer;
}
.vitalityToastClose:hover {
  color: #ffffff;
}

@keyframes toastSlideUp {
  0% {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Mobile Clearance for 56px Mobile Dock */
@media (max-width: 768px) {
  .vitalityScoreSection {
    margin: 20px 4% 36px;
  }
  .vitalityToastContainer {
    left: 16px;
    right: 16px;
    bottom: 74px; /* Clearance above 56px .mobileDock */
  }
  .vitalityToastCard {
    max-width: 100%;
    padding: 12px 14px;
  }
}


/* =========================================================================
   HEALTHIANS & REDCLIFFE LABS WORLD-CLASS BENCHMARK EXTENSIONS
   ========================================================================= */

/* Top Navigation Bar Enhancements */
.navPillBtn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 9999px;
  font-size: 13px;
  font-weight: 600;
  border: 1px solid rgba(56, 189, 248, 0.25);
  background: rgba(14, 165, 233, 0.08);
  color: #38bdf8;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.navPillBtn:hover {
  background: rgba(14, 165, 233, 0.18);
  border-color: rgba(56, 189, 248, 0.5);
  transform: translateY(-1px);
}
.navPillBtn.green {
  border-color: rgba(52, 211, 153, 0.25);
  background: rgba(16, 185, 129, 0.08);
  color: #34d399;
}
.navPillBtn.green:hover {
  background: rgba(16, 185, 129, 0.18);
  border-color: rgba(52, 211, 153, 0.5);
}

/* 3D VFX Hero Container & Canvas */
.hero3DContainer {
  position: relative;
  overflow: hidden;
  border-radius: 24px;
  background: linear-gradient(135deg, #051322 0%, #071e35 50%, #051525 100%);
  border: 1px solid rgba(56, 189, 248, 0.2);
  box-shadow: 0 20px 50px -10px rgba(2, 6, 23, 0.7);
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  min-height: 480px;
  padding: 40px;
  margin: 16px auto;
  max-width: 1280px;
}
@media (max-width: 900px) {
  .hero3DContainer {
    grid-template-columns: 1fr;
    padding: 24px 20px;
    min-height: auto;
  }
}
.hero3DCanvasWrapper {
  position: relative;
  width: 100%;
  height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
}
@media (max-width: 900px) {
  .hero3DCanvasWrapper {
    height: 300px;
  }
}

/* Telemetry Pills in Hero */
.telemetryGrid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-top: 24px;
}
@media (max-width: 600px) {
  .telemetryGrid {
    grid-template-columns: 1fr;
  }
}
.telemetryPill {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  background: rgba(15, 23, 42, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  font-size: 12px;
  color: #e2e8f0;
  backdrop-blur-sm: 8px;
}
.telemetryPill b {
  display: block;
  color: #fff;
  font-size: 13px;
}
.telemetryPill small {
  color: #94a3b8;
  font-size: 11px;
}

/* Organ & Health Concern Discovery Grid (Healthians / Redcliffe Standard) */
.organGridSection {
  max-width: 1280px;
  margin: 40px auto 20px;
  padding: 0 16px;
}
.organGridTitleRow {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20px;
}
.organGrid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12px;
}
@media (max-width: 1100px) {
  .organGrid {
    grid-template-columns: repeat(4, 1fr);
  }
}
@media (max-width: 640px) {
  .organGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}
.organCard {
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.8) 0%, rgba(10, 16, 26, 0.95) 100%);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 16px;
  padding: 16px 12px;
  text-align: center;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  position: relative;
  overflow: hidden;
}
.organCard:hover, .organCard.active {
  transform: translateY(-4px);
  border-color: rgba(56, 189, 248, 0.4);
  box-shadow: 0 12px 24px -6px rgba(14, 165, 233, 0.25);
  background: linear-gradient(180deg, rgba(14, 165, 233, 0.12) 0%, rgba(10, 16, 26, 0.98) 100%);
}
.organIconBadge {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: transform 0.2s ease;
}
.organCard:hover .organIconBadge {
  transform: scale(1.12);
}
.organCardName {
  font-size: 13px;
  font-weight: 700;
  color: #f1f5f9;
  line-height: 1.2;
}
.organCardTag {
  font-size: 10px;
  color: #94a3b8;
  white-space: nowrap;
}

/* Healthians & Redcliffe Style Package Card Overhaul */
.curatedPackagesGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 20px;
  margin-top: 24px;
}
.curatedCard {
  background: linear-gradient(180deg, #09131e 0%, #060c14 100%);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 20px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  position: relative;
}
.curatedCard:hover {
  transform: translateY(-5px);
  border-color: rgba(56, 189, 248, 0.35);
  box-shadow: 0 20px 40px -12px rgba(14, 165, 233, 0.2);
}
.curatedCardTop {
  padding: 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  position: relative;
}
.curatedBadgeRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
}
.curatedParamPill {
  font-size: 11px;
  font-weight: 700;
  color: #38bdf8;
  background: rgba(14, 165, 233, 0.12);
  border: 1px solid rgba(56, 189, 248, 0.25);
  padding: 3px 9px;
  border-radius: 9999px;
}
.curatedDiscountPill {
  font-size: 11px;
  font-weight: 800;
  color: #f43f5e;
  background: rgba(244, 63, 94, 0.12);
  border: 1px solid rgba(244, 63, 94, 0.25);
  padding: 3px 8px;
  border-radius: 9999px;
}
.curatedTitle {
  font-size: 18px;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
  margin-bottom: 6px;
}
.curatedDesc {
  font-size: 13px;
  color: #94a3b8;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Clinical Specification Specs Row */
.curatedSpecsRow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 12px 20px;
  background: rgba(15, 23, 42, 0.4);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  font-size: 11px;
  color: #cbd5e1;
}
.curatedSpecItem {
  display: flex;
  align-items: center;
  gap: 6px;
}
.curatedSpecItem svg {
  color: #38bdf8;
  shrink: 0;
}

/* Card Pricing & Action Bar */
.curatedCardBottom {
  padding: 16px 20px;
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  background: rgba(5, 10, 18, 0.6);
}
.curatedPriceBox {
  display: flex;
  flex-direction: column;
}
.curatedPriceMain {
  font-size: 22px;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}
.curatedPriceOld {
  font-size: 12px;
  color: #64748b;
  text-decoration: line-through;
  margin-top: 2px;
}
.curatedActionGroup {
  display: flex;
  align-items: center;
  gap: 8px;
}
.btnViewDetails {
  padding: 8px 12px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 600;
  color: #94a3b8;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.btnViewDetails:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.09);
  border-color: rgba(255, 255, 255, 0.25);
}
.btnBookNow {
  padding: 8px 16px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  color: #020617;
  background: linear-gradient(135deg, #38bdf8 0%, #34d399 100%);
  border: none;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(56, 189, 248, 0.25);
  transition: all 0.2s ease;
  white-space: nowrap;
}
.btnBookNow:hover {
  opacity: 0.95;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(56, 189, 248, 0.35);
}

/* Quality & Accreditation Section */
.qualitySection {
  max-width: 1280px;
  margin: 60px auto 30px;
  padding: 40px 24px;
  background: linear-gradient(180deg, #071526 0%, #050d18 100%);
  border: 1px solid rgba(56, 189, 248, 0.15);
  border-radius: 24px;
}
.qualityGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-top: 32px;
}
@media (max-width: 900px) {
  .qualityGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 550px) {
  .qualityGrid {
    grid-template-columns: 1fr;
  }
}
.qualityCard {
  padding: 24px;
  background: rgba(15, 23, 42, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.qualityCardIcon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(56, 189, 248, 0.1);
  border: 1px solid rgba(56, 189, 248, 0.2);
  color: #38bdf8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qualityCardTitle {
  font-size: 16px;
  font-weight: 700;
  color: #ffffff;
}
.qualityCardDesc {
  font-size: 13px;
  color: #94a3b8;
  line-height: 1.6;
}

/* FAQ Accordion Section */
.faqSection {
  max-width: 1000px;
  margin: 40px auto 60px;
  padding: 0 16px;
}
.faqItem {
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 14px;
  margin-bottom: 12px;
  background: rgba(15, 23, 42, 0.6);
  overflow: hidden;
  transition: all 0.2s ease;
}
.faqQuestion {
  width: 100%;
  padding: 18px 20px;
  text-align: left;
  font-size: 15px;
  font-weight: 600;
  color: #f1f5f9;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}
.faqAnswer {
  padding: 0 20px 20px;
  font-size: 13.5px;
  color: #94a3b8;
  line-height: 1.7;
}
